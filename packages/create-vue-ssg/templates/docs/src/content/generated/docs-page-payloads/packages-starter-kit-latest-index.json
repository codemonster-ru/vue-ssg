{"id":"packages-starter-kit-latest-index","blocks":[{"type":"heading","depth":2,"id":"starter-kit","html":"Starter Kit"},{"type":"paragraph","html":"Welcome to your first package docs."},{"type":"heading","depth":2,"id":"overview","html":"Overview"},{"type":"paragraph","html":"Use this page as the package landing section."},{"type":"heading","depth":2,"id":"next-steps","html":"Next steps"},{"type":"list","ordered":false,"items":["Add more markdown files under <code>content/packages/starter-kit/latest</code>.","Update <code>metadata.json</code> with the real package name and repository URL.","Add more package folders under <code>content/packages</code>."]},{"type":"heading","depth":2,"id":"vue-playground-demo","html":"Vue Playground Demo"},{"type":"paragraph","html":"Keep Vue demo source in markdown so synced docs stay self-contained."},{"type":"playground","files":{"/App.vue":"<template>\n  <main class=\"demo\">\n    <VfCard outlined>\n      <h2>Vue runtime smoke</h2>\n      <p>Bundled by Vite, rendered without iframe runtime.</p>\n      <VfBadge outlined>vueforge-core</VfBadge>\n      <VfButton color=\"accent\">Smoke passed</VfButton>\n    </VfCard>\n  </main>\n</template>\n\n<script setup>\nimport { VfBadge, VfButton, VfCard } from '@codemonster-ru/vueforge-core'\n</script>\n\n<style scoped>\n.demo {\n  padding: var(--vf-layout-space-layout-lg);\n  display: grid;\n  align-content: start;\n  gap: var(--vf-layout-space-layout-base);\n  background: linear-gradient(\n    180deg,\n    color-mix(in oklab, var(--vf-color-bg) 92%, var(--vf-color-brand-primary) 8%),\n    var(--vf-color-bg)\n  );\n}\n\nh2 {\n  margin: 0 0 12px;\n  font-size: 42px;\n  line-height: 1.1;\n}\n\np {\n  margin: 0 0 20px;\n}\n\n.vf-button {\n  width: 100%;\n  justify-content: center;\n  margin-top: 20px;\n}\n</style>\n"},"entry":"/App.vue","framework":"vue","height":360,"renderMode":"component"}],"tableOfContents":[{"id":"starter-kit","label":"Starter Kit","level":1},{"id":"overview","label":"Overview","level":1},{"id":"next-steps","label":"Next steps","level":1},{"id":"vue-playground-demo","label":"Vue Playground Demo","level":1}]}